{
  "id": "line-flip",
  "title": {
    "zh": "线路额度",
    "en": "Line quota"
  },
  "description": {
    "zh": "一张自己会翻面的线路卡：正面是这条订阅线路的额度窗口、进度条与重置倒计时，背面是它的账号池、当前账号与三档轮换策略。",
    "en": "A self-flipping line card: the front shows this subscription line's quota windows, meters and reset countdowns; the back shows its account pool, the active account and the three rotation strategies."
  },
  "author": "dsh-chatgpt-subscription",
  "version": "0.1.0",
  "sizes": [
    "s",
    "m",
    "l"
  ],
  "source": "dsh-chatgpt-subscription:line-card",
  "capabilities": [
    "dsh-chatgpt-subscription:line-refresh",
    "dsh-chatgpt-subscription:line-account-switch",
    "dsh-chatgpt-subscription:line-account-strategy"
  ],
  "refresh": {
    "mode": "interval",
    "everyMs": 60000
  },
  "minBox": {
    "w": 1,
    "h": 14
  },
  "defaultBox": {
    "w": 2,
    "h": 20
  },
  "props": {
    "type": "object",
    "required": [
      "line"
    ],
    "properties": {
      "line": {
        "type": "string",
        "enum": [
          "codex",
          "kimi-code",
          "minimax-code",
          "antigravity",
          "command-code",
          "claude",
          "glm-coding-plan",
          "step-code",
          "qoder",
          "cline-pass",
          "opendesign"
        ]
      }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "line": {
        "type": "string"
      },
      "label": {
        "type": [
          "string",
          "null"
        ]
      },
      "signedIn": {
        "type": "boolean"
      },
      "installed": {
        "type": "boolean"
      },
      "planLabel": {
        "type": [
          "string",
          "null"
        ]
      },
      "accountLabel": {
        "type": [
          "string",
          "null"
        ]
      },
      "accounts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "email": {
              "type": [
                "string",
                "null"
              ]
            },
            "primary": {
              "type": "boolean"
            },
            "plan": {
              "type": [
                "string",
                "null"
              ]
            },
            "cooldownUntil": {
              "type": [
                "number",
                "null"
              ]
            },
            "authStatus": {
              "type": [
                "string",
                "null"
              ]
            },
            "usedPercent": {
              "type": [
                "number",
                "null"
              ]
            },
            "resetsAt": {
              "type": [
                "number",
                "null"
              ]
            },
            "windows": {
              "type": "array",
              "description": "Every window this account's own reading stated, shortest first. Absent on a line with no per-account read; [] means the read was made and measured nothing.",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "usedPercent": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "windowMinutes": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "resetsAt": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "activeAccountId": {
        "type": [
          "string",
          "null"
        ]
      },
      "strategy": {
        "type": "string"
      },
      "quota": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "windows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "usedPercent": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "windowMinutes": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "resetsAt": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              },
              "credits": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "unlimited": {
                        "type": "boolean"
                      },
                      "balance": {
                        "type": [
                          "string",
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resetCredits": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "available": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "expiresAt": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fetchedAt": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "refreshing": {
                "type": "boolean"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "text": {
    "title": {
      "zh": "线路额度",
      "en": "Line quota"
    },
    "props.line.label": {
      "zh": "线路",
      "en": "Line"
    },
    "props.line.hint": {
      "zh": "这张卡显示哪条订阅线路：codex=ChatGPT · kimi-code=Kimi 会员 · minimax-code=MiniMax Code · antigravity=Antigravity · command-code=Command Code · claude=Claude · glm-coding-plan=GLM 编程套餐 · step-code=Step Code · qoder=Qoder · cline-pass=Cline Pass · opendesign=OpenDesign",
      "en": "Which subscription line this card shows: codex=ChatGPT · kimi-code=Kimi · minimax-code=MiniMax Code · antigravity=Antigravity · command-code=Command Code · claude=Claude · glm-coding-plan=GLM coding plan · step-code=Step Code · qoder=Qoder · cline-pass=Cline Pass · opendesign=OpenDesign"
    },
    "line.codex": {
      "zh": "ChatGPT",
